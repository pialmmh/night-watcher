# /etc/nw/nw-agent-mysql-master.env  — agent on the MySQL master host
#
# Passive node: no facets → no probes fire. Agent still maintains
# heartbeat + observation cache so it has the cluster picture for when
# the local-self probe is re-enabled in a later milestone.

NW_NODE_NAME=mysql-master
NW_AGENT_CLUSTER_NAME=btcl-mysql
NW_AGENT_CLUSTER_TYPE=MySqlMasterSlave

NW_AGENT_FABRIC_ENDPOINTS=http://127.0.0.1:2379,http://10.10.199.42:2379,http://10.10.199.43:2379

QUARKUS_HTTP_PORT=7102
QUARKUS_HTTP_HOST=0.0.0.0
