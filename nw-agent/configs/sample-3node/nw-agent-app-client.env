# /etc/nw/nw-agent-app-client.env  — agent on the app / JDBC-client host
#
# The only active observer. Carries the mysql-client-here facet so the
# mysql.remote.client probe arms; runs the failure tracker; drives the
# FailoverCoordinator state machine when the master fails 3 ticks in a row.

NW_NODE_NAME=app-client
NW_AGENT_CLUSTER_NAME=btcl-mysql
NW_AGENT_CLUSTER_TYPE=MySqlMasterSlave

NW_AGENT_FABRIC_ENDPOINTS=http://127.0.0.1:2379,http://10.10.199.41:2379,http://10.10.199.42:2379

# Static facet enabling the client probe on this host only.
NW_AGENT_STATIC_FACETS=mysql-client-here

# ── MySQL probe config ─────────────────────────────────────────────────────
# Target = the master VIP, or the master host directly for the demo.
NW_MYSQL_CLIENT_TARGET_HOST=10.10.199.41
NW_MYSQL_PORT=3306
NW_MYSQL_USERNAME=nw_monitor
# Override at runtime via supervisord env file: NW_MYSQL_PASSWORD=…
NW_MYSQL_PASSWORD=changeme

# Default is "SHOW DATABASES"; override here for a tenant-specific canary.
NW_MYSQL_CUSTOM_QUERY=SHOW DATABASES

NW_MYSQL_FAST_THRESHOLD_MS=50
NW_MYSQL_DEGRADED_THRESHOLD_MS=500
NW_MYSQL_DEAD_THRESHOLD_MS=5000
NW_MYSQL_CONNECT_TIMEOUT_SEC=2
NW_MYSQL_QUERY_TIMEOUT_SEC=3

# ── Failover tuning ────────────────────────────────────────────────────────
# 3 consecutive DEAD verdicts → MasterDeadDetected → SM fires.
NW_FAILOVER_FAILURE_THRESHOLD=3
NW_FAILOVER_TRIGGER_INVESTIGATORS=mysql.remote.client
NW_FAILOVER_FENCE_TIMEOUT_SEC=10
NW_FAILOVER_PROMOTE_TIMEOUT_SEC=10

QUARKUS_HTTP_PORT=7102
QUARKUS_HTTP_HOST=0.0.0.0
